                "description": "Format of composite id should be `o:organization_slug:t:team_slug`.\n"
              },
              {
                "name": "page[cursor]",
                "value": "",
                "type": "query",
                "description": "The cursor used for pagination. The value of the cursor must be retrieved from pagination links included in previous responses; you should not attempt to write them on your own.\n"
              }
            ]
          },
          "docs": "Get team manager relationships."
        },
        {
          "info": {
            "name": "Add managers to team",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://rest.api.transifex.com/teams/:team_id/relationships/managers",
            "params": [
              {
                "name": "team_id",
                "value": "",
