{
  "opencollection": "1.0.0",
  "info": {
    "name": "Transifex Activity Reports Teams API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
