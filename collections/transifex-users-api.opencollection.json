{
  "opencollection": "1.0.0",
  "info": {
    "name": "Transifex Activity Reports Users API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the details of a User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.api.transifex.com/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "Format of the user id should be `u:username`."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the details of the user specified by the required path parameter `user_id`."
        }
      ]
    }
  ],
  "bundled": true
}